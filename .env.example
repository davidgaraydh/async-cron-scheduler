# API Configuration
# API key for authentication (currently not required, but can be set for future use)
API_KEY=your-secret-api-key-here

# Port where the API server will listen
API_PORT=8000

# Host where the API server will bind (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# Storage Configuration
# Storage backend type: 'sqlite' or 'json'
STORAGE_TYPE=sqlite

# SQLite database path (only used if STORAGE_TYPE=sqlite)
SQLITE_DB_PATH=./data/scheduler.db

# JSON storage file path (only used if STORAGE_TYPE=json)
JSON_STORAGE_PATH=./data/tasks.json

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: 'json' for structured JSON logs, or 'text' for plain text
LOG_FORMAT=json

# Scheduler Configuration
# Maximum number of tasks that can run concurrently
MAX_CONCURRENT_TASKS=10

# Default timeout for tasks in seconds (5 minutes)
DEFAULT_TASK_TIMEOUT=300

# Default maximum number of retries for failed tasks
DEFAULT_MAX_RETRIES=3
